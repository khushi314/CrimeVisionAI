# ============================================================================
# CrimeVision AI — Environment Configuration Template
# Copy this file to `.env` for local execution:
#   cp .env.example .env
# Never commit your actual `.env` file or secret API keys to GitHub.
# ============================================================================

# Gemini API Key (Used by the Node/Express multimodal forensic gateway in server.ts)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Groq API Key & Model (Used by the Python Flask backend in backend/utils/groq_utils.py)
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: When running the Python Flask backend (`python backend/app.py` on port 5000),
# set FLASK_BACKEND_URL so the frontend/gateway forwards API requests to Flask.
# Leave empty to use the built-in Node + FFmpeg + Gemini multimodal engine directly.
FLASK_BACKEND_URL=""

# Local Server Ports
PORT=3000
FLASK_PORT=5000

# Model Device Preference for Python Backend ("auto", "cuda", or "cpu")
FORENSIC_DEVICE="auto"

# Offline / Lightweight Fallback Mode for Unit Testing without 2GB+ Model Downloads ("true" or "false")
CRIMEVISION_LIGHTWEIGHT_MODE="false"
